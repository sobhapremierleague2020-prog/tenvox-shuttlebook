rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Scorer allowlist: only these signed-in emails can save or delete scores.
    // Use lowercase emails. Add or remove scorers here, then click Publish.
    function isScorer() {
      return request.auth != null
        && request.auth.token.email in [
          'scorer1@example.com',
          'scorer2@example.com'
        ];
    }

    match /matches/{matchId} {
      allow read: if true;          // everyone can watch live scores, no login
      allow write: if isScorer();   // only listed scorers can score
    }

    match /{document=**} {
      allow read, write: if false;  // nothing else is open
    }
  }
}
